# Copy to .env (docker compose reads it automatically). All values below have working dev defaults.

ENVIRONMENT=development            # "production" refuses to boot with the default secrets below
POSTGRES_PASSWORD=marketplace
JWT_SECRET=                        # REQUIRED in production: random, >= 32 chars (e.g. `openssl rand -hex 32`)
PAYMENT_WEBHOOK_SECRET=            # REQUIRED in production: shared secret with the payment gateway

# --- AI providers ---------------------------------------------------------------------------------
# LLM_PROVIDER:       mock (rule-based, no network) | gemini | ollama
# EMBEDDING_PROVIDER: hash (offline dev embedder)   | gemini | ollama
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
# The pgvector column dimension is fixed by the migration (768). If you change EMBEDDING_DIM you must
# add a migration and re-run `python -c "from app.core.database import SessionLocal; ..."` reindex (see README).
EMBEDDING_DIM=768
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash   # model names get retired; if search logs "LLM extraction unavailable ... 404", pick a current one
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Host ports (change if something else already uses them) -------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
ADMIN_PORT=3001                    # separate admin console
ADMIN_URL=http://localhost:3001    # shown to admins who try the main site's login; set to your admin hostname in prod
POSTGRES_HOST_PORT=5433
